digraph ERD {
  graph [rankdir=LR, bgcolor="#F7F1EA", pad=0.4, nodesep=0.7, ranksep=1.3, fontname="Helvetica", splines=spline];
  node  [shape=plain, fontname="Helvetica"];
  edge  [fontname="Helvetica", fontsize=11, color="#6B4630", fontcolor="#4A3224", penwidth=1.6, dir=both,
         arrowtail=teetee, arrowhead=crowodot, arrowsize=1.1];

  categories [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#C8915B" BGCOLOR="#FFFDFA">
      <TR><TD COLSPAN="3" BGCOLOR="#4A3224"><FONT COLOR="white" POINT-SIZE="15"><B>categories</B></FONT></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>category_id</B></TD><TD ALIGN="LEFT">INT, AUTO_INCREMENT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">category_name</TD><TD ALIGN="LEFT">VARCHAR(60), UNIQUE</TD></TR>
    </TABLE>>];

  suppliers [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#C8915B" BGCOLOR="#FFFDFA">
      <TR><TD COLSPAN="3" BGCOLOR="#4A3224"><FONT COLOR="white" POINT-SIZE="15"><B>suppliers</B></FONT></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>supplier_code</B></TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">supplier_name</TD><TD ALIGN="LEFT">VARCHAR(100), UNIQUE</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">contact_email</TD><TD ALIGN="LEFT">VARCHAR(120)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">contact_phone</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR>
    </TABLE>>];

  products [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#C8915B" BGCOLOR="#FFFDFA">
      <TR><TD COLSPAN="3" BGCOLOR="#6B4630"><FONT COLOR="white" POINT-SIZE="15"><B>products</B></FONT></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>sku</B></TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">product_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR>
      <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">category_id</TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">supplier_code</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">reorder_level</TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">TINYINT(1)</TD></TR>
    </TABLE>>];

  stock_movements [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#C8915B" BGCOLOR="#FFFDFA">
      <TR><TD COLSPAN="3" BGCOLOR="#8A5A3B"><FONT COLOR="white" POINT-SIZE="15"><B>stock_movements</B></FONT></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>movement_id</B></TD><TD ALIGN="LEFT">INT, AUTO_INCREMENT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">movement_date</TD><TD ALIGN="LEFT">DATE</TD></TR>
      <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">sku</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR>
      <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">warehouse_code</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">movement_type</TD><TD ALIGN="LEFT">ENUM(IN, OUT, ADJUST)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">handled_by</TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">remarks</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">posted_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
    </TABLE>>];

  warehouses [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#C8915B" BGCOLOR="#FFFDFA">
      <TR><TD COLSPAN="3" BGCOLOR="#4A3224"><FONT COLOR="white" POINT-SIZE="15"><B>warehouses</B></FONT></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>warehouse_code</B></TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">warehouse_name</TD><TD ALIGN="LEFT">VARCHAR(80)</TD></TR>
    </TABLE>>];

  users [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#C8915B" BGCOLOR="#FFFDFA">
      <TR><TD COLSPAN="3" BGCOLOR="#4A3224"><FONT COLOR="white" POINT-SIZE="15"><B>users (employees)</B></FONT></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>user_id</B></TD><TD ALIGN="LEFT">INT, AUTO_INCREMENT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">employee_code</TD><TD ALIGN="LEFT">VARCHAR(20), UNIQUE</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(120), UNIQUE</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">ENUM(manager, staff)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">TINYINT(1)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
    </TABLE>>];

  categories      -> products        [label="classifies"];
  suppliers       -> products        [label="supplies"];
  products        -> stock_movements [label="is moved in"];
  warehouses      -> stock_movements [label="holds"];
  users           -> stock_movements [label="handles"];

  {rank=same; categories; suppliers;}
  {rank=same; warehouses; users;}
}
